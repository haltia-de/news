# Maintainer: Mikhail Nevskiy <rensomail@gmail.com>
pkgname=haltia-news
pkgver=2.2.2
pkgrel=0
pkgdesc="Новости: News from the papers one picks (GTK 3)"
url="https://github.com/haltia-de/news"
arch="noarch"
# The name before ADR 0004: apk upgrade carries b8k-news over to this.
provides="b8k-news=$pkgver-r$pkgrel"
replaces="b8k-news"
license="GPL-2.0-only"
depends="python3 py3-gobject3 gtk+3.0 py3-feedparser"
source="$pkgname-$pkgver.tar.gz::https://github.com/haltia-de/news/archive/v$pkgver.tar.gz"
builddir="$srcdir/news-$pkgver"

options="!check"

package() {
	sh ./install.sh "$pkgdir" /usr
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"
